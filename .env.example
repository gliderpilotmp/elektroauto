# Zugangsdaten deines Fiat / My Uconnect Kontos
UCONNECT_EMAIL=deine@email.at
UCONNECT_PASSWORD=deinPasswort
# 4-stellige PIN aus der Fiat-App (für Fernbefehle wie Klima)
UCONNECT_PIN=1234
# Region: FIAT_EU (Europa), FIAT_US, ...
UCONNECT_BRAND=FIAT_EU
# Optional: bestimmte VIN, sonst wird das erste Fahrzeug verwendet
UCONNECT_VIN=
# Schützt die Web-App mit einem Passwort (dringend empfohlen, wenn von außen erreichbar)
APP_PASSWORD=
# Demo-Modus ohne echtes Auto (automatisch aktiv, wenn keine Zugangsdaten gesetzt sind)
DEMO=false
