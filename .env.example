# Zugangsdaten deines Fiat / My Uconnect Kontos
UCONNECT_EMAIL=deine@email.at
UCONNECT_PASSWORD=deinPasswort
# 4-stellige PIN aus der Fiat-App (für Fernbefehle wie Klima)
UCONNECT_PIN=1234
# Region: FIAT_EU (Europa), FIAT_US, ...
UCONNECT_BRAND=FIAT_EU
# Optional: bestimmte VIN, sonst wird das erste Fahrzeug verwendet
UCONNECT_VIN=
# Schützt die Web-App mit einem Passwort (dringend empfohlen, wenn von außen erreichbar)
APP_PASSWORD=
# Wie oft das Auto im Hintergrund abgefragt wird (Minuten), beim Laden öfter
POLL_MINUTES=10
POLL_MINUTES_CHARGING=5
# Wie lange die Klimatisierung nach dem Einschalten läuft (Minuten). Der 500e meldet
# keinen Klima-Status, die App zeigt daher eine geschätzte Restzeit.
CLIMATE_MINUTES=15
# Optional: zusätzlich Benachrichtigungen über ntfy (z.B. https://ntfy.sh/mein-geheimes-thema)
NTFY_URL=
# Optional: Kontaktadresse für Web-Push (manche Push-Dienste verlangen eine echte Adresse)
VAPID_SUBJECT=
# Demo-Modus ohne echtes Auto (automatisch aktiv, wenn keine Zugangsdaten gesetzt sind)
DEMO=false
